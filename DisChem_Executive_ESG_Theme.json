{
  "name": "Dis-Chem Executive ESG Assurance Theme",
  "dataColors": [
    "#00563B",
    "#0F172A",
    "#0D9488",
    "#10B981",
    "#F59E0B",
    "#DC2626",
    "#3B82F6",
    "#6366F1",
    "#8B5CF6",
    "#0284C7",
    "#14B8A6",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#00563B",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#00563B",
  "center": "#0D9488",
  "minimum": "#DC2626",
  "null": "#94A3B8",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 22,
      "color": "#0F172A"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#334155"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9.5,
      "color": "#64748B"
    },
    "smallLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 8.5,
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowBlur": 10,
            "distance": 3,
            "angle": 45,
            "transparency": 88
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11.5,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 35
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 20,
            "color": { "solid": { "color": "#0F172A" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "color": { "solid": { "color": "#64748B" } }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9.5,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } },
            "autoSizeColumnWidth": true
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColorPrimary": { "solid": { "color": "#1E293B" } },
            "fontColorSecondary": { "solid": { "color": "#334155" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#F1F5F9" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 4
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9.5,
            "fontColor": { "solid": { "color": "#00563B" } },
            "backColor": { "solid": { "color": "#F8FAFC" } }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9.5,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } }
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#0F172A" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColorPrimary": { "solid": { "color": "#1E293B" } },
            "fontColorSecondary": { "solid": { "color": "#334155" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#F1F5F9" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 4
          }
        ],
        "subTotals": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#00563B" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#0F172A" } }
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#334155" } },
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    }
  }
}
